{
  "name": "heavyfactor",
  "productName": "HeavyFactor",
  "version": "1.1.0",
  "description": "App de dieta para musculação, treino e suplementação",
  "homepage": "https://github.com/Githyot/MacroFactorBR",
  "author": {
    "name": "Githyot",
    "email": "117548028+Githyot@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "br.heavyfactor.app",
    "productName": "HeavyFactor",
    "files": [
      "main.js",
      "web/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "icon": "icon.png",
      "maintainer": "HeavyFactor",
      "synopsis": "Dieta, treino e suplementação para musculação",
      "artifactName": "HeavyFactor-${version}-${arch}.${ext}"
    },
    "publish": null,
    "deb": {
      "fpm": [
        "--replaces",
        "macrofactorbr",
        "--conflicts",
        "macrofactorbr"
      ]
    },
    "rpm": {
      "fpm": [
        "--replaces",
        "macrofactorbr",
        "--conflicts",
        "macrofactorbr"
      ]
    }
  }
}
