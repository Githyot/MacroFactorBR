{
  "expo": {
    "name": "MacroFactorBR",
    "slug": "macrofactorbr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.macrofactor.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.macrofactor.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "O MacroFactorBR usa a câmera para ler códigos de barras e tabelas nutricionais.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O MacroFactorBR acessa suas fotos para ler tabelas nutricionais.",
          "cameraPermission": "O MacroFactorBR usa a câmera para fotografar tabelas nutricionais."
        }
      ]
    ],
    "scheme": "macrofactorbr"
  }
}
