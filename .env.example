# Copie para .env e preencha. Sem estas variáveis o app funciona 100% offline
# (sem login, sincronização, base compartilhada e IA).

# Supabase: Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat: chaves públicas dos apps (Project settings > API keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# true liga a cobrança do Pro. Enquanto false, tudo fica liberado (beta).
EXPO_PUBLIC_PAYWALL_ENABLED=false
